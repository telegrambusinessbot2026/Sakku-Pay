# ==============================================================================
# SakkuPay Staging Environment Configuration Template
# Copy to staging/.env.staging and configure staging-specific values.
# NEVER commit staging/.env.staging to version control.
# ==============================================================================

NODE_ENV=staging
PORT=3001
DB_PATH=./staging/sakkupay_staging.db
DATA_JSON_PATH=./staging/data.json
TRUST_PROXY=true

# Staging-Specific High-Entropy Cryptographic Secrets
# Generate using: openssl rand -hex 32
SAKKUPAY_TOKEN_SECRET=staging-token-secret-replace-with-at-least-32-chars
VAULT_SECRET=staging-vault-secret-replace-with-at-least-32-chars
ADMIN_USERNAME=staging_admin
ADMIN_PASSWORD=staging-admin-password-replace-with-at-least-12-chars

# Sandbox / Synthetic Gateway Identifiers
PHONEPE_ENV=SANDBOX
PAYTM_ENV=STAGING
