# ==============================================================================
# SakkuPay Environment Configuration
# ==============================================================================

# Environment Mode: 'development' or 'production'
# In production, the server enforces strict 32+ character secrets on startup.
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# Database Configuration
# Path to SQLite database file. Defaults to sakkupay.db in project root.
DB_PATH=./sakkupay.db

# Reverse Proxy Trust (default: false)
# Set to 'true' if running behind Cloudflare, Nginx, or Render reverse proxies
# to correctly resolve client IP addresses for rate limiting.
TRUST_PROXY=false

# Session & Token Security
# Secret key used to sign HMAC-SHA256 merchant and admin session tokens.
# IN PRODUCTION: Generate using `openssl rand -hex 32` (minimum 32 characters).
# The server will refuse to boot in production if using default or weak secrets.
SAKKUPAY_TOKEN_SECRET=development-only-change-this-secret

# Vault Secret for Encrypted Business Gateway Tokens (AES-256-GCM)
# IN PRODUCTION: Generate using `openssl rand -hex 32` (minimum 32 characters).
VAULT_SECRET=vault-encryption-secret-key-change-in-production

# Google OAuth 2.0 (Merchant Sign-In)
# Obtain these credentials from Google Cloud Console (https://console.cloud.google.com/)
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Optional: defaults to `${origin}/api/auth/google/callback`
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Admin Dashboard Credentials
# Credentials to access the restricted Admin Dashboard at `/admin`
ADMIN_USERNAME=admin
# IN PRODUCTION: Set to a strong password of at least 12 characters.
ADMIN_PASSWORD=changeme123
