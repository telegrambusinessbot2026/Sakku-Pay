# ==============================================================================
# SakkuPay — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials, tokens, or production connection strings to Git.
# - '.env' is strictly excluded via .gitignore.
# - In production (Render / Railway / VPS), configure these environment variables
#   directly in your hosting provider's dashboard or secrets manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Environment Mode: 'development' | 'production'
# - 'development': Permitted to use local SQLite and fallback development secrets.
# - 'production': Strictly enforces 32+ character random secrets on startup and
#   requires persistent database configuration (DATABASE_URL or DB_PATH).
# Required: YES
NODE_ENV=development

# Server Port
# Port the Node.js HTTP server will bind to.
# Render automatically injects PORT dynamically; local development defaults to 3000.
# Required: OPTIONAL (default: 3000)
PORT=3000

# Canonical Application Base URL
# The public base URL used to construct customer payment link URLs (/pay/:slug).
# - Local: http://localhost:3000
# - Production: https://sakkupay.onrender.com
# Required: RECOMMENDED in production
APP_URL=http://localhost:3000

# Reverse Proxy Trust ('true' | 'false')
# Enable when running behind Render, Cloudflare, Nginx, or AWS ALB proxies
# so that req.socket.remoteAddress resolves actual client IPs from X-Forwarded-For.
# Required: RECOMMENDED in production (set to true on Render)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE STORAGE
# ------------------------------------------------------------------------------
# SQLite Database File Path
# High-performance built-in Node.js v22+ DatabaseSync with Write-Ahead Logging (WAL).
# - Local development: ./sakkupay.db
# - Production with Render Persistent Disk: /var/data/sakkupay.db
# Required: YES if DATABASE_URL is not set
DB_PATH=./sakkupay.db

# Managed PostgreSQL Connection String (Production Only)
# When set, enables the 'pg' connection pool with TLS/SSL encryption for cloud
# managed databases (Render PostgreSQL, Supabase, Neon, AWS RDS).
# Example: postgresql://username:password@dpg-host-a:5432/sakkupay_db
# Required: YES for managed PostgreSQL in production; leave blank for local SQLite
DATABASE_URL=

# PostgreSQL Connection Pool Max Clients
# Maximum concurrent connections maintained by the pg pool.
# Required: OPTIONAL (default: 20)
DB_POOL_MAX=20

# Legacy Data JSON Snapshot Path
# File path for backwards-compatible export/import snapshots.
# Required: OPTIONAL (default: ./data.json)
DATA_JSON_PATH=./data.json

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, CRYPTOGRAPHY & SECURITY SECRETS
# ------------------------------------------------------------------------------
# HMAC-SHA256 Secret for Merchant and Admin Session Tokens
# Used to cryptographically sign session cookies and Bearer tokens.
# IN PRODUCTION: Generate using `openssl rand -hex 32` (minimum 32 characters).
# Server startup will abort in production if weak/default secrets are detected.
# Required: YES (32+ characters in production)
SAKKUPAY_TOKEN_SECRET=development-only-change-this-secret

# AES-256-GCM Vault Key for Encrypting Business Gateway Credentials
# Used to encrypt sensitive PhonePe/Paytm Merchant IDs and Salt Keys before disk storage.
# IN PRODUCTION: Generate using `openssl rand -hex 32` (minimum 32 characters).
# Server startup will abort in production if weak/default secrets are detected.
# Required: YES (32+ characters in production)
VAULT_SECRET=vault-encryption-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (MERCHANT SIGN-IN)
# ------------------------------------------------------------------------------
# 1-click Google Sign-In for merchants.
# Obtain from Google Cloud Console: https://console.cloud.google.com/
# APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI:
#   Local: http://localhost:3000/api/auth/google/callback
#   Production: https://sakkupay.onrender.com/api/auth/google/callback
# Required: YES for Google Sign-In functionality
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 5. RESTRICTED ADMIN DASHBOARD (/admin)
# ------------------------------------------------------------------------------
# Primary SuperAdmin credentials for administrative investigation, RBAC, and audit logs.
# IN PRODUCTION: Use a secure username and set ADMIN_PASSWORD to 12+ characters.
# Required: YES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@sakkupay.local
